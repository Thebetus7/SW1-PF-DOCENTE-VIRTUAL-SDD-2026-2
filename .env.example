# =================================================================
# VARIABLES DE ENTORNO CENTRALIZADAS (SW1-PF-DOCENTE-VIRTUAL-SDD-2026-2)
# =================================================================
# Copia este archivo a `.env` en la raíz y/o en `apps/backend/.env`
# y completa los valores correspondientes.
# NUNCA subas archivos .env a repositorios públicos o compartidos.

# -----------------------------------------------------------------
# 1. Base de Datos PostgreSQL (Prisma ORM)
# -----------------------------------------------------------------
DATABASE_URL="postgresql://postgres:123456789@localhost:5432/cursos-profe-virtual?schema=public"

# -----------------------------------------------------------------
# 2. Autenticación y Seguridad JWT
# -----------------------------------------------------------------
JWT_SECRET="dev-super-secret-jwt-key-2026-adaptative-lms-sw1"
JWT_REFRESH_SECRET="dev-super-secret-refresh-key-2026-adaptative-lms-sw1"

# -----------------------------------------------------------------
# 3. Inteligencia Artificial (GroqCloud - LLaMA 3.3)
# -----------------------------------------------------------------
GROQ_API_KEY="gsk_tu_clave_de_groqcloud_aqui"

# -----------------------------------------------------------------
# 4. Pasarela de Pagos Stripe (Modo Sandbox / Desarrollador)
# Requiere estrictamente prefijo sk_test_* para prevenir cargos reales
# -----------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_tu_clave_de_stripe_test_aqui"

# -----------------------------------------------------------------
# 5. Puertos y Direcciones del Servidor
# -----------------------------------------------------------------
PORT=3000
VITE_API_URL="http://localhost:3000/api/v1"
